{
  "title": "awesome-dsh-themes registry",
  "type": "object",
  "required": [
    "updated",
    "themes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Registry of dsh themes and --dsw-* token skins. themes.json is source of truth.",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "themes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/theme"
      }
    }
  },
  "$defs": {
    "theme": {
      "type": "object",
      "required": [
        "name",
        "repo",
        "description",
        "kind",
        "added",
        "lastVerified",
        "verifiedAgainst",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "verifiedAgainst": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "runtime",
            "skin"
          ]
        },
        "official": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "verified",
            "unverified",
            "broken"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "description": "path#key of the file on the repo's default branch that proves the restyle path. Required whenever status is verified."
        },
        "added": {
          "type": "string",
          "format": "date"
        },
        "lastVerified": {
          "type": "string",
          "format": "date"
        },
        "npm": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "runtime",
            "tokens",
            "skin",
            "companion",
            "fun"
          ],
          "description": "Gallery/README grouping. kind stays runtime|skin; category is the public shelf."
        },
        "preview": {
          "type": "string",
          "minLength": 1,
          "description": "URL of a real preview image. Never a mock or invented screenshot."
        },
        "previewCss": {
          "type": "string",
          "minLength": 1,
          "description": "URL of a --dsw-* override stylesheet for the full-page live preview."
        },
        "install": {
          "type": "string",
          "minLength": 1,
          "description": "Optional install one-liner. If omitted, gallery derives `dsh plugin --profile web add github:owner/repo` from repo."
        },
        "gist": {
          "type": "string",
          "minLength": 1,
          "description": "Optional gist id or URL for a gist-hosted theme."
        }
      }
    }
  }
}
